generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum StepStatus {
  PENDING
  COMPLETED
}

enum BatchStatus {
  IN_QUEUE
  IN_PROGRESS
  COMPLETE
  FLAGGED
}

enum LabResult {
  PENDING
  PASS
  FAIL
}

enum LotStatus {
  ACTIVE
  RESERVED
  CONSUMED
  SCRAPPED
  QUARANTINED
}

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}

enum MovementType {
  RECEIVE
  CONSUME
  PRODUCE
  TRANSFER
  ADJUSTMENT
  SCRAP
}

enum EquipmentStatus {
  RUNNING
  IDLE
  DOWN
  MAINTENANCE
  SETUP
  CHANGEOVER
}

enum DowntimeCategory {
  PLANNED
  UNPLANNED
  CHANGEOVER
  MATERIAL_WAIT
  QUALITY_HOLD
  MAINTENANCE
}

enum ShiftPattern {
  FIRST    // 7am-3pm
  SECOND   // 3pm-11pm
  THIRD    // 11pm-7am
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

//////////////////////////////////////////////////////
// CORE ENTITIES — EXISTING
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   // Tech, Supervisor, Admin
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  movements Movement[]
  labReports LabReport[]
  signoffs  Signoff[]
}

model WorkOrder {
  id        String     @id @default(cuid())
  tenantId  String     @default("default")
  title     String
  steps     Step[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())

  // --- Production execution fields ---
  materialId     String?
  material       Material?       @relation("WorkOrderOutputMaterial", fields: [materialId], references: [id])

  bomId          String?
  bom            BOM?            @relation(fields: [bomId], references: [id])

  quantity       Float?
  uom            String?

  status         WorkOrderStatus @default(PLANNED)

  scheduledStart DateTime?
  scheduledEnd   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  updatedAt      DateTime        @updatedAt

  // --- Production relations ---
  workOrderSteps     WorkOrderStep[]  // Advanced MES step execution with operator tracking
  reservations       Reservation[]
  outputLots         Lot[]
  inventoryMovements InventoryMovement[]
}

// Step: Simple step model for basic work order tracking
// Used by the original work order system for straightforward step completion
model Step {
  id          String     @id @default(cuid())
  tenantId    String     @default("default")
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id])
  title       String
  status      StepStatus @default(PENDING)
  notes       String?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
}

model AuditLog {
  id          String    @id @default(cuid())
  tenantId    String    @default("default")
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  stepId      String
  actorUserId String
  actorUser   User      @relation(fields: [actorUserId], references: [id])
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())
}

model Tenant {
  id             String       @id @default(cuid())
  name           String
  sapPlantCode   String?
  createdAt      DateTime     @default(now())
  users          User[]
  plantAreas     PlantArea[]
  workCenters    WorkCenter[]
  materials      Material[]
  batches        Batch[]
  movements      Movement[]
  labReports     LabReport[]
  signoffs       Signoff[]
  equipment      Equipment[]
}

// PlantArea: Physical building / section of the Rutherfordton site.
// Trelleborg Rutherfordton has three: Main Plant, Shipping, New Plant.
// Work centers and equipment belong to a plant area.
model PlantArea {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])

  code            String       // "MAIN", "SHIP", "NEW"
  name            String       // "Main Plant", "Shipping", "New Plant"
  description     String?

  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workCenters     WorkCenter[]
  equipment       Equipment[]

  @@unique([tenantId, code])
}

model WorkCenter {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  name            String
  code            String
  description     String?

  plantAreaId     String?
  plantArea       PlantArea? @relation(fields: [plantAreaId], references: [id])

  createdAt       DateTime   @default(now())
  batches         Batch[]    @relation("CurrentWorkCenter")
  movementsFrom   Movement[] @relation("FromWorkCenter")
  movementsTo     Movement[] @relation("ToWorkCenter")
  equipment       Equipment[]

  @@unique([tenantId, code])
}

model Material {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  sapMaterialNumber String?
  description       String
  unitOfMeasure     String    @default("EA")
  createdAt         DateTime  @default(now())
  batches           Batch[]

  // --- New fields for lot genealogy & BOM engine ---
  name              String?
  isBatchTracked    Boolean   @default(true)
  updatedAt         DateTime  @updatedAt

  // --- New relations ---
  lots              Lot[]
  boms              BOM[]       @relation("BOMOutputMaterial")
  bomItems          BOMItem[]   @relation("BOMItemMaterial")
  workOrders        WorkOrder[] @relation("WorkOrderOutputMaterial")

  @@unique([tenantId, sapMaterialNumber])
}

model Batch {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  materialId     String
  material       Material    @relation(fields: [materialId], references: [id])
  lotNumber      String
  quantity       Decimal
  status         BatchStatus @default(IN_QUEUE)
  workCenterId   String
  workCenter     WorkCenter  @relation("CurrentWorkCenter", fields: [workCenterId], references: [id])
  movements      Movement[]
  labReports     LabReport[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, lotNumber])
}

model Movement {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  batchId          String
  batch            Batch      @relation(fields: [batchId], references: [id])
  fromWorkCenterId String
  fromWorkCenter   WorkCenter @relation("FromWorkCenter", fields: [fromWorkCenterId], references: [id])
  toWorkCenterId   String
  toWorkCenter     WorkCenter @relation("ToWorkCenter", fields: [toWorkCenterId], references: [id])
  quantity         Decimal
  movedByUserId    String
  movedByUser      User       @relation(fields: [movedByUserId], references: [id])
  movedAt          DateTime   @default(now())
  notes            String?
  olympusCommitId  String?
}

model LabReport {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  batchId         String
  batch           Batch      @relation(fields: [batchId], references: [id])
  fileHash        String
  fileUrl         String
  fileName        String
  result          LabResult  @default(PENDING)
  submittedBy     String
  submittedByUser User       @relation(fields: [submittedBy], references: [id])
  submittedAt     DateTime   @default(now())
  olympusCommitId String?
  signoff         Signoff?
}

model Signoff {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  labReportId     String    @unique
  labReport       LabReport @relation(fields: [labReportId], references: [id])
  managerId       String
  manager         User      @relation(fields: [managerId], references: [id])
  signedAt        DateTime  @default(now())
  notes           String?
  olympusCommitId String?
}

//////////////////////////////////////////////////////
// LOT GRAPH (GENEALOGY DAG)
//////////////////////////////////////////////////////

model Lot {
  id            String    @id @default(uuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id])

  quantity      Float
  uom           String

  status        LotStatus @default(ACTIVE)
  expiryDate    DateTime?

  workOrderId   String?
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Genealogy edges
  parentEdges   LotEdge[] @relation("ParentLot")
  childEdges    LotEdge[] @relation("ChildLot")

  reservations  Reservation[]
  movements     InventoryMovement[]
}

model LotEdge {
  id           String   @id @default(uuid())

  parentLotId  String
  childLotId   String

  parentLot    Lot @relation("ParentLot", fields: [parentLotId], references: [id])
  childLot     Lot @relation("ChildLot", fields: [childLotId], references: [id])

  quantity     Float // amount transferred from parent → child

  createdAt    DateTime @default(now())

  @@unique([parentLotId, childLotId])
}

//////////////////////////////////////////////////////
// BOM ENGINE (VERSIONED + EXECUTABLE)
//////////////////////////////////////////////////////

model BOM {
  id           String   @id @default(uuid())
  materialId   String   // output material
  material     Material @relation("BOMOutputMaterial", fields: [materialId], references: [id])

  version      Int
  isActive     Boolean  @default(true)

  validFrom    DateTime
  validTo      DateTime?

  createdAt    DateTime @default(now())

  items        BOMItem[]
  steps        BOMStep[]
  workOrders   WorkOrder[]

  @@unique([materialId, version])
}

model BOMItem {
  id          String   @id @default(uuid())
  bomId       String
  bom         BOM      @relation(fields: [bomId], references: [id])

  materialId  String
  material    Material @relation("BOMItemMaterial", fields: [materialId], references: [id])

  quantity    Float
  uom         String

  isOptional  Boolean  @default(false)

  // for conditional logic later
  condition   String?  // JSON logic or rule reference

  createdAt   DateTime @default(now())
}

model BOMStep {
  id          String   @id @default(uuid())
  bomId       String
  bom         BOM      @relation(fields: [bomId], references: [id])

  name        String
  sequence    Int

  machineType String?  // press, mixer, etc
  durationSec Int?

  // constraints (store as JSON for flexibility)
  constraints Json?

  createdAt   DateTime @default(now())

  workOrderSteps WorkOrderStep[]
}

//////////////////////////////////////////////////////
// WORK ORDER EXECUTION (PRODUCTION LAYER)
//////////////////////////////////////////////////////

// WorkOrderStep: Advanced MES step execution model
// Used for production tracking with BOM steps, operator assignment, and data recording
// Distinct from Step model which is for simple work order tracking
model WorkOrderStep {
  id            String   @id @default(uuid())

  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])

  bomStepId     String
  bomStep       BOMStep  @relation(fields: [bomStepId], references: [id])

  status        String   // pending, in_progress, completed, blocked

  startedAt     DateTime?
  completedAt   DateTime?

  operatorId    String?
  operator      Operator? @relation(fields: [operatorId], references: [id])

  data          Json?    // actual recorded values (temp, pressure, etc)

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// INVENTORY + RESERVATIONS
//////////////////////////////////////////////////////

model Reservation {
  id            String @id @default(uuid())

  lotId         String
  lot           Lot @relation(fields: [lotId], references: [id])

  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])

  quantity      Float

  status        ReservationStatus @default(ACTIVE)

  createdAt     DateTime @default(now())
}

model InventoryMovement {
  id            String @id @default(uuid())

  lotId         String
  lot           Lot @relation(fields: [lotId], references: [id])

  type          MovementType

  quantity      Float

  workOrderId   String?
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id])

  operatorId    String?
  operator      Operator? @relation(fields: [operatorId], references: [id])

  metadata      Json?

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// OPERATORS (AUDITABILITY)
//////////////////////////////////////////////////////

model Operator {
  id        String @id @default(uuid())
  name      String
  badgeId   String? @unique

  createdAt DateTime @default(now())

  steps     WorkOrderStep[]
  movements InventoryMovement[]
  shifts    ShiftAssignment[]
}

//////////////////////////////////////////////////////
// EQUIPMENT + DOWNTIME (AXXOS INTEGRATION)
//////////////////////////////////////////////////////

model Equipment {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])

  code            String          // e.g., "PRESS-01", "MIX-03"
  name            String          // e.g., "Banbury Mixer #3"
  type            String          // press, mixer, extruder, calender, mill
  description     String?

  workCenterId    String?
  workCenter      WorkCenter?     @relation(fields: [workCenterId], references: [id])

  plantAreaId     String?
  plantArea       PlantArea?      @relation(fields: [plantAreaId], references: [id])

  // Axxos mapping
  axxosEquipmentId String?        // External Axxos equipment identifier

  // Current state (denormalized for fast reads on station dashboard)
  status          EquipmentStatus @default(IDLE)
  statusSince     DateTime        @default(now())
  currentOperatorId String?

  // Capacity / targets
  targetCycleTimeSec Int?         // Expected cycle time in seconds
  targetOee       Float?          // Target OEE % (e.g., 0.85)

  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  downtimeEvents  DowntimeEvent[]

  @@unique([tenantId, code])
}

model DowntimeEvent {
  id              String           @id @default(uuid())
  tenantId        String

  equipmentId     String
  equipment       Equipment        @relation(fields: [equipmentId], references: [id])

  category        DowntimeCategory
  reasonCode      String           // e.g., "MAT-WAIT", "MOLD-CHANGE", "BREAKDOWN-HYDRAULIC"
  reasonText      String?          // Free-text from operator: "Waiting for compound from mixer"

  startedAt       DateTime         @default(now())
  endedAt         DateTime?        // null = still down
  durationMin     Float?           // Computed on close, or periodically updated

  // Who reported it
  reportedById    String?
  workOrderId     String?          // Which WO was affected
  plantAreaCode   String?          // Which plant area: "MAIN", "SHIP", "NEW"

  // Escalation
  escalatedToTeams Boolean         @default(false)
  escalatedAt     DateTime?

  metadata        Json?            // Axxos sync data, machine codes, etc.

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ScrapReason {
  id              String   @id @default(uuid())
  tenantId        String

  code            String   // e.g., "VISC-OOS", "CONTAM", "CURE-FAIL", "EQUIP-MAL"
  description     String   // e.g., "Off-spec viscosity", "Contamination"
  category        String   // quality, equipment, process, material
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())

  @@unique([tenantId, code])
}

//////////////////////////////////////////////////////
// SHIFT MANAGEMENT
//////////////////////////////////////////////////////

model ShiftAssignment {
  id              String       @id @default(uuid())
  tenantId        String

  operatorId      String
  operator        Operator     @relation(fields: [operatorId], references: [id])

  shift           ShiftPattern
  date            DateTime     @db.Date  // Calendar date of shift
  workCenterCode  String?      // Which station they're assigned to
  plantAreaCode   String?      // Which building: "MAIN", "SHIP", "NEW"

  clockInAt       DateTime?
  clockOutAt      DateTime?

  notes           String?

  createdAt       DateTime     @default(now())

  @@unique([tenantId, operatorId, date, shift])
}

//////////////////////////////////////////////////////
// TEAMS NOTIFICATIONS
//////////////////////////////////////////////////////

model TeamsWebhook {
  id              String   @id @default(uuid())
  tenantId        String

  name            String           // "Maintenance Alerts", "QC Channel", "Shift Leads"
  webhookUrl      String           // MS Teams incoming webhook URL
  channel         String           // "#main-plant-alerts", "#shipping-alerts", "#new-plant-alerts"

  // Scope: which plant area this webhook covers (null = all areas)
  plantAreaCode   String?          // "MAIN", "SHIP", "NEW" — or null for site-wide

  // What triggers this webhook
  onDowntime      Boolean  @default(true)
  onQualityFail   Boolean  @default(true)
  onShortage      Boolean  @default(true)
  onEscalation    Boolean  @default(true)

  // Escalation rules
  downtimeThresholdMin Int @default(15) // Alert after N minutes of downtime

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, name])
}
