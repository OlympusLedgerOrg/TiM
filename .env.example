# ----------------------------
# TiM Project Environment Variables
# ----------------------------
# This is a shared example file for both backend and frontend development.

# ----------------------------
# Backend Configuration
# ----------------------------

# PostgreSQL connection (for local dev, use localhost)
DATABASE_URL="postgresql://tim:tim@localhost:5432/tim"

# JWT secret for authentication (change in production!)
JWT_SECRET="change-me"

# Socket.IO path (default setting)
SOCKET_IO_PATH="/socket.io"

# Express backend port
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Optional: log level (info, warn, error, debug)
LOG_LEVEL=info

# ----------------------------
# Frontend Configuration
# ----------------------------

# API base URL (used by Vite for proxying requests)
VITE_API_BASE="/api"

# Frontend development port
VITE_PORT=5173

# ----------------------------
# PostgreSQL Configuration
# ----------------------------

POSTGRES_USER=tim
POSTGRES_PASSWORD=tim
POSTGRES_DB=tim

# ----------------------------
# Notes
# ----------------------------
# - For Docker Compose, DATABASE_URL host will be overridden to 'db' automatically
# - Copy this file to .env and adjust values as needed for your local environment
# - Never commit .env files with real credentials to version control
