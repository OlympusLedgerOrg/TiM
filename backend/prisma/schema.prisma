generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum StepStatus {
  PENDING
  COMPLETED
}

enum BatchStatus {
  IN_QUEUE
  IN_PROGRESS
  COMPLETE
  FLAGGED
}

enum LabResult {
  PENDING
  PASS
  FAIL
}

enum LotStatus {
  ACTIVE
  RESERVED
  CONSUMED
  SCRAPPED
  QUARANTINED
}

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}

enum MovementType {
  RECEIVE
  CONSUME
  PRODUCE
  TRANSFER
  ADJUSTMENT
  SCRAP
}

//////////////////////////////////////////////////////
// CORE ENTITIES — EXISTING
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   // Tech, Supervisor, Admin
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  movements Movement[]
  labReports LabReport[]
  signoffs  Signoff[]
}

model WorkOrder {
  id        String     @id @default(cuid())
  tenantId  String     @default("default")
  title     String
  steps     Step[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())

  // --- Production execution fields ---
  materialId     String?
  material       Material?       @relation("WorkOrderOutputMaterial", fields: [materialId], references: [id])

  bomId          String?
  bom            BOM?            @relation(fields: [bomId], references: [id])

  quantity       Float?
  uom            String?

  status         WorkOrderStatus @default(PLANNED)

  scheduledStart DateTime?
  scheduledEnd   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  updatedAt      DateTime        @updatedAt

  // --- Production relations ---
  workOrderSteps     WorkOrderStep[]
  reservations       Reservation[]
  outputLots         Lot[]
  inventoryMovements InventoryMovement[]
}

model Step {
  id          String     @id @default(cuid())
  tenantId    String     @default("default")
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id])
  title       String
  status      StepStatus @default(PENDING)
  notes       String?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
}

model AuditLog {
  id          String    @id @default(cuid())
  tenantId    String    @default("default")
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  stepId      String
  actorUserId String
  actorUser   User      @relation(fields: [actorUserId], references: [id])
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())
}

model Tenant {
  id             String       @id @default(cuid())
  name           String
  sapPlantCode   String?
  createdAt      DateTime     @default(now())
  users          User[]
  workCenters    WorkCenter[]
  materials      Material[]
  batches        Batch[]
  movements      Movement[]
  labReports     LabReport[]
  signoffs       Signoff[]
}

model WorkCenter {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  name            String
  code            String
  description     String?
  createdAt       DateTime   @default(now())
  batches         Batch[]    @relation("CurrentWorkCenter")
  movementsFrom   Movement[] @relation("FromWorkCenter")
  movementsTo     Movement[] @relation("ToWorkCenter")

  @@unique([tenantId, code])
}

model Material {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  sapMaterialNumber String?
  description       String
  unitOfMeasure     String    @default("EA")
  createdAt         DateTime  @default(now())
  batches           Batch[]

  // --- New fields for lot genealogy & BOM engine ---
  name              String?
  isBatchTracked    Boolean   @default(true)
  updatedAt         DateTime  @updatedAt

  // --- New relations ---
  lots              Lot[]
  boms              BOM[]       @relation("BOMOutputMaterial")
  bomItems          BOMItem[]   @relation("BOMItemMaterial")
  workOrders        WorkOrder[] @relation("WorkOrderOutputMaterial")

  @@unique([tenantId, sapMaterialNumber])
}

model Batch {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  materialId     String
  material       Material    @relation(fields: [materialId], references: [id])
  lotNumber      String
  quantity       Decimal
  status         BatchStatus @default(IN_QUEUE)
  workCenterId   String
  workCenter     WorkCenter  @relation("CurrentWorkCenter", fields: [workCenterId], references: [id])
  movements      Movement[]
  labReports     LabReport[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, lotNumber])
}

model Movement {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  batchId          String
  batch            Batch      @relation(fields: [batchId], references: [id])
  fromWorkCenterId String
  fromWorkCenter   WorkCenter @relation("FromWorkCenter", fields: [fromWorkCenterId], references: [id])
  toWorkCenterId   String
  toWorkCenter     WorkCenter @relation("ToWorkCenter", fields: [toWorkCenterId], references: [id])
  quantity         Decimal
  movedByUserId    String
  movedByUser      User       @relation(fields: [movedByUserId], references: [id])
  movedAt          DateTime   @default(now())
  notes            String?
  olympusCommitId  String?
}

model LabReport {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  batchId         String
  batch           Batch      @relation(fields: [batchId], references: [id])
  fileHash        String
  fileUrl         String
  fileName        String
  result          LabResult  @default(PENDING)
  submittedBy     String
  submittedByUser User       @relation(fields: [submittedBy], references: [id])
  submittedAt     DateTime   @default(now())
  olympusCommitId String?
  signoff         Signoff?
}

model Signoff {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  labReportId     String    @unique
  labReport       LabReport @relation(fields: [labReportId], references: [id])
  managerId       String
  manager         User      @relation(fields: [managerId], references: [id])
  signedAt        DateTime  @default(now())
  notes           String?
  olympusCommitId String?
}

//////////////////////////////////////////////////////
// LOT GRAPH (GENEALOGY DAG)
//////////////////////////////////////////////////////

model Lot {
  id            String    @id @default(uuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id])

  quantity      Float
  uom           String

  status        LotStatus @default(ACTIVE)

  workOrderId   String?
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Genealogy edges
  parentEdges   LotEdge[] @relation("ParentLot")
  childEdges    LotEdge[] @relation("ChildLot")

  reservations  Reservation[]
  movements     InventoryMovement[]
}

model LotEdge {
  id           String   @id @default(uuid())

  parentLotId  String
  childLotId   String

  parentLot    Lot @relation("ParentLot", fields: [parentLotId], references: [id])
  childLot     Lot @relation("ChildLot", fields: [childLotId], references: [id])

  quantity     Float // amount transferred from parent → child

  createdAt    DateTime @default(now())

  @@unique([parentLotId, childLotId])
}

//////////////////////////////////////////////////////
// BOM ENGINE (VERSIONED + EXECUTABLE)
//////////////////////////////////////////////////////

model BOM {
  id           String   @id @default(uuid())
  materialId   String   // output material
  material     Material @relation("BOMOutputMaterial", fields: [materialId], references: [id])

  version      Int
  isActive     Boolean  @default(true)

  validFrom    DateTime
  validTo      DateTime?

  createdAt    DateTime @default(now())

  items        BOMItem[]
  steps        BOMStep[]
  workOrders   WorkOrder[]

  @@unique([materialId, version])
}

model BOMItem {
  id          String   @id @default(uuid())
  bomId       String
  bom         BOM      @relation(fields: [bomId], references: [id])

  materialId  String
  material    Material @relation("BOMItemMaterial", fields: [materialId], references: [id])

  quantity    Float
  uom         String

  isOptional  Boolean  @default(false)

  // for conditional logic later
  condition   String?  // JSON logic or rule reference

  createdAt   DateTime @default(now())
}

model BOMStep {
  id          String   @id @default(uuid())
  bomId       String
  bom         BOM      @relation(fields: [bomId], references: [id])

  name        String
  sequence    Int

  machineType String?  // press, mixer, etc
  durationSec Int?

  // constraints (store as JSON for flexibility)
  constraints Json?

  createdAt   DateTime @default(now())

  workOrderSteps WorkOrderStep[]
}

//////////////////////////////////////////////////////
// WORK ORDER EXECUTION (PRODUCTION LAYER)
//////////////////////////////////////////////////////

model WorkOrderStep {
  id            String   @id @default(uuid())

  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])

  bomStepId     String
  bomStep       BOMStep  @relation(fields: [bomStepId], references: [id])

  status        String   // pending, in_progress, completed, blocked

  startedAt     DateTime?
  completedAt   DateTime?

  operatorId    String?
  operator      Operator? @relation(fields: [operatorId], references: [id])

  data          Json?    // actual recorded values (temp, pressure, etc)

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// INVENTORY + RESERVATIONS
//////////////////////////////////////////////////////

model Reservation {
  id            String @id @default(uuid())

  lotId         String
  lot           Lot @relation(fields: [lotId], references: [id])

  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])

  quantity      Float

  status        ReservationStatus @default(ACTIVE)

  createdAt     DateTime @default(now())
}

model InventoryMovement {
  id            String @id @default(uuid())

  lotId         String
  lot           Lot @relation(fields: [lotId], references: [id])

  type          MovementType

  quantity      Float

  workOrderId   String?
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id])

  operatorId    String?
  operator      Operator? @relation(fields: [operatorId], references: [id])

  metadata      Json?

  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// OPERATORS (AUDITABILITY)
//////////////////////////////////////////////////////

model Operator {
  id        String @id @default(uuid())
  name      String
  badgeId   String? @unique

  createdAt DateTime @default(now())

  steps     WorkOrderStep[]
  movements InventoryMovement[]
}
