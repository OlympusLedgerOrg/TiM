# ----------------------------
# TiM Project Environment Variables
# ----------------------------
# This is a shared example file for both backend and frontend development.

# ----------------------------
# Backend Configuration
# ----------------------------

# PostgreSQL connection (for local dev, use localhost)
DATABASE_URL="postgresql://tim:tim@localhost:5432/tim"

# JWT secret for authentication (change in production!)
JWT_SECRET="change-me"

# Socket.IO path (default setting)
SOCKET_IO_PATH="/socket.io"

# Express backend port
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Optional: log level (info, warn, error, debug)
LOG_LEVEL=info

# ----------------------------
# Frontend Configuration
# ----------------------------

# API base URL (used by Vite for proxying requests)
VITE_API_BASE="/api"

# Frontend development port
VITE_PORT=5173

# ----------------------------
# PostgreSQL Configuration
# ----------------------------

POSTGRES_USER=tim
POSTGRES_PASSWORD=tim
POSTGRES_DB=tim

# ----------------------------
# Notes
# ----------------------------
# - For Docker Compose, DATABASE_URL host will be overridden to 'db' automatically
# - Copy this file to .env and adjust values as needed for your local environment
# - Never commit .env files with real credentials to version control

# ----------------------------
# Rate Limiting
# ----------------------------

# Requests per minute for global limiter (default: 100)
RATE_LIMIT_GLOBAL=100

# Requests per minute for SAP endpoints (default: 30)
RATE_LIMIT_SAP=30

# Requests per minute for auth endpoints (default: 10)
RATE_LIMIT_AUTH=10

# ----------------------------
# HTTPS Configuration
# ----------------------------

# Disable HTTPS redirect when TLS is terminated at the proxy/load balancer
DISABLE_HTTPS_REDIRECT=true

# ----------------------------
# SAP Middleware Configuration
# ----------------------------

# Middleware type: PI_PO or CLOUD_INTEGRATION
SAP_MIDDLEWARE_TYPE=CLOUD_INTEGRATION

# SAP middleware base URL
# SAP_MIDDLEWARE_URL=https://your-cpi-tenant.it-cpi.cfapps.eu10.hana.ondemand.com

# Authentication type: BASIC, OAUTH2, or CERTIFICATE
SAP_MIDDLEWARE_AUTH_TYPE=BASIC

# OAuth2 client ID (for OAUTH2 auth type)
# SAP_MIDDLEWARE_CLIENT_ID=your-client-id

# Enable/disable SAP middleware connectivity
SAP_MIDDLEWARE_ENABLED=false

# SAP logical system name (used in IDoc partner fields)
SAP_SYSTEM_ID=SAPCLNT100

# ----------------------------
# Axxos OEE Integration
# ----------------------------

# Axxos API base URL (for equipment status polling)
# AXXOS_API_URL=https://axxos.trelleborg.local/api/v1

# Axxos API key or credentials
# AXXOS_API_KEY=your-axxos-api-key

# Polling interval in seconds (how often TiM checks Axxos for equipment state)
AXXOS_POLL_INTERVAL_SEC=30

# Enable/disable Axxos connectivity
AXXOS_ENABLED=false

# ----------------------------
# Microsoft Teams Notifications
# ----------------------------

# Teams webhooks are configured per-tenant via the /api/v1/teams/webhooks endpoint.
# Example channel webhooks for Rutherfordton:
#
# Main Plant Alerts:  https://outlook.office.com/webhook/main-plant-xxx
# Shipping Alerts:    https://outlook.office.com/webhook/shipping-xxx
# New Plant Alerts:   https://outlook.office.com/webhook/new-plant-xxx
# QC Team:            https://outlook.office.com/webhook/qc-team-xxx
# Shift Leads:        https://outlook.office.com/webhook/shift-leads-xxx
#
# Downtime escalation threshold (minutes) — default: 15
TEAMS_ESCALATION_CHECK_INTERVAL_SEC=300

# ----------------------------
# Desktop Mode Configuration
# ----------------------------

# Set to 'true' when running as desktop app (auto-set by Electron wrapper)
TIM_DESKTOP_MODE=false

# Path to serve static frontend files (used in desktop mode)
# STATIC_FILES_PATH=/path/to/frontend/dist

# ----------------------------
# Olympus Ledger Anchoring
# ----------------------------

# Base URL of the Olympus node. Leave empty to disable anchoring entirely —
# nothing is enqueued and the outbox drainer does not start.
OLYMPUS_URL=

# API key presented as `x-api-key`. The key needs the `write`, `ingest`, or
# `admin` scope on the Olympus side, or ingest is rejected 403.
OLYMPUS_API_KEY=

# Target shard. Must already exist in the Olympus shard registry — shard
# creation is operator-controlled there (`POST /admin/shards`), and writing to
# an unregistered shard is rejected 403. `files` is the shard Olympus seeds by
# default. Grammar: 1-128 chars of [A-Za-z0-9:._-].
OLYMPUS_SHARD_ID=files

# Per-request timeout for a single ingest call (ms).
OLYMPUS_TIMEOUT_MS=15000

# Outbox drainer tuning. Defaults are shown; all are optional.
# Rows claimed per pass:
OLYMPUS_OUTBOX_BATCH_SIZE=10
# Idle delay between passes, ms (a full batch skips the wait and drains again):
OLYMPUS_OUTBOX_POLL_MS=10000
# How long a claimed row stays invisible to other workers, ms. Must exceed
# OLYMPUS_TIMEOUT_MS or a slow request could have its row re-claimed:
OLYMPUS_OUTBOX_VISIBILITY_MS=120000
# Retryable attempts before a row is parked in DEAD_LETTER:
OLYMPUS_OUTBOX_MAX_ATTEMPTS=12
